  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412\u0441\u0435\u0432\u043E\u043B\u043E\u0434 \u0427\u0435\u0440\u043D\u0438\u043A\u043E\u0432,
    @chev  \u2013 \u043C\u0430\u0441\u0442\u0435\u0440 \u043D\u0430 \u0432\u0441\u0435
    \u0440\u0443\u043A\u0438\r\n\n\u0410\u043D\u0442\u043E\u043D \u0413\u043E\u0440\u0434\u0438\u0435\u043D\u043A\u043E,
    @antos_codes \u2013 Unity-\u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\r\n\n\u041B\u043E\u0440\u0430
    \u0412\u0430\u043D\u044F\u043D, @rupture \u2013 3D-\u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\r\n\n\u041B\u0438\u043B\u0438\u044F
    \u0420\u0430\u0434\u0447\u0435\u043D\u043A\u043E, @lily_scalette \u2013 \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0441\u0442,
    \u043D\u0430\u0440\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0439 \u0434\u0438\u0437\u0430\u0439\u043D\u0435\u0440\r\n\n\u0414\u0430\u043D\u0438\u0438\u043B
    \u0421\u0435\u0447\u0438\u043D, @wulfgard \u2013 Unity-\u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\r\n\n\u0417\u0443\u043B\u044C\u0444\u0438\u044F
    \u041A\u0430\u0437\u0438\u0445\u0430\u043D\u043E\u0432\u0430, @mishka_po \u2013
    3D-\u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\r\n\n\u041A\u0438\u0440\u0438\u043B\u043B
    \u0415\u0440\u043C\u043E\u043B\u0430\u0435\u0432, @yeager1st \u2013 Unity-\u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\r\n\n@barashe_haha
    \u2013 \u0442\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0449\u0438\u043A\r\n\n\r\n\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
    \u0437\u0430 \u0437\u0432\u0443\u043A\u0438 KanoAlgiz\r\n"
